{
  "info": {
    "_postman_id": "7cda9972-0ef1-4fa2-a24a-95739f6fdccb",
    "name": "Refinery Import API",
    "description": "Integración para consultar contenedores pendientes y registrar importaciones. Usa un token consumidor para GET/POST y un token administrativo para PATCH/DELETE.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{consumer_token}}", "type": "string" }
    ]
  },
  "item": [
    {
      "name": "1. Listar contenedores pendientes de arribar",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" }
        ],
        "url": "{{base_url}}/api/v1/importaciones?pendiente_arribo=1&con_contenedor=1&orden_fecha=asc&per_page=100",
        "description": "Obtiene los contenedores en Documentación, En tránsito o En altamar, ordenados por fecha estimada de arribo."
      },
      "response": []
    },
    {
      "name": "2. Crear importación",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Estado HTTP 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "const respuesta = pm.response.json();",
              "pm.collectionVariables.set('importacion_id', respuesta.data.id);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"bl\": \"MSCU-202608001\",\n  \"referencia\": \"IMP-2026-030\",\n  \"proveedor\": \"GEA WESTFALIA\",\n  \"material\": \"Centrífuga para refinación\",\n  \"transportista\": \"MSC\",\n  \"origen\": \"Hamburgo, Alemania\",\n  \"puerto_destino\": \"Puerto Santo Tomás\",\n  \"incoterm\": \"CIF Puerto Santo Tomás\",\n  \"fecha_estimada_arribo\": \"2026-09-15\",\n  \"estado\": \"En tránsito\",\n  \"progreso\": 35,\n  \"contenedor\": \"MSCU 202608-1\",\n  \"bultos\": \"4 cajas / 2,450 kg\",\n  \"destino_planta\": \"Edificio de Refinería · Almacén técnico\",\n  \"duca\": \"En preparación\",\n  \"factura\": \"GEA-2026-882\",\n  \"valor_usd\": 175500.75\n}"
        },
        "url": "{{base_url}}/api/v1/importaciones",
        "description": "Crea un expediente y guarda su ID en la variable importacion_id."
      },
      "response": []
    },
    {
      "name": "3. Consultar importación creada",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" }
        ],
        "url": "{{base_url}}/api/v1/importaciones/{{importacion_id}}"
      },
      "response": []
    },
    {
      "name": "4. Actualizar importación creada",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            { "key": "token", "value": "{{admin_token}}", "type": "string" }
          ]
        },
        "method": "PATCH",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"estado\": \"Recibida\",\n  \"progreso\": 100,\n  \"duca\": \"DUCA-GT 160001 · Definitiva\"\n}"
        },
        "url": "{{base_url}}/api/v1/importaciones/{{importacion_id}}"
      },
      "response": []
    },
    {
      "name": "5. Eliminar importación creada",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            { "key": "token", "value": "{{admin_token}}", "type": "string" }
          ]
        },
        "method": "DELETE",
        "header": [
          { "key": "Accept", "value": "application/json" }
        ],
        "url": "{{base_url}}/api/v1/importaciones/{{importacion_id}}"
      },
      "response": []
    },
    {
      "name": "6. Probar validación (422)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"bl\": \"\",\n  \"estado\": \"Estado inválido\",\n  \"progreso\": 150\n}"
        },
        "url": "{{base_url}}/api/v1/importaciones",
        "description": "Demuestra las respuestas JSON de validación con código HTTP 422."
      },
      "response": []
    }
  ],
  "variable": [
    { "key": "base_url", "value": "https://refinery-import-api.onrender.com", "type": "string" },
    { "key": "consumer_token", "value": "PEGA_AQUI_EL_VALOR_DE_EXTERNAL_API_CONSUMER_TOKEN", "type": "string" },
    { "key": "admin_token", "value": "PEGA_AQUI_EL_VALOR_DE_EXTERNAL_API_TOKEN", "type": "string" },
    { "key": "importacion_id", "value": "1", "type": "string" }
  ]
}
